# Copy this file to .env.local and replace the placeholders with your own
# project values. Never commit .env.local.

# ─── Required: Supabase Auth and farm database ───────────────────────────────
# Find these in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: your canonical production URL, used for social sharing metadata.
# On Vercel, the production deployment URL is used when this is not set.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
